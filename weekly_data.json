      "name": "Grilled Chicken Breast with Street Corn Salad and Brown Rice",
      "seasonal_items_used": ["corn", "cherry tomatoes"],
      "macros_per_serving": {
        "protein_g": 51,
        "fat_g": 11,
        "carbs_g": 69,
        "calories": 579
      },
      "prep_time": "15 min",
      "cook_time": "25 min",
      "servings": 4,
      "ingredients": [
        { "item": "chicken breast", "quantity": "2 lbs", "source": "Costco" },
        { "item": "brown rice", "quantity": "2 cups dry", "source": "Costco" },
        { "item": "fresh corn on the cob", "quantity": "3 ears", "source": "HEB" },
        { "item": "cherry tomatoes", "quantity": "1 cup halved", "source": "HEB" },
        { "item": "plain Greek yogurt", "quantity": "4 tbsp", "source": "Costco" },
        { "item": "lime juice", "quantity": "2 tbsp", "source": "HEB" },
        { "item": "garlic powder", "quantity": "1 tsp", "source": "Pantry" },
        { "item": "olive oil", "quantity": "4 tsp total (1 tsp per serving)", "source": "Costco" },
        { "item": "salt", "quantity": "to taste", "source": "Pantry" },
        { "item": "low-sodium chicken broth", "quantity": "4 cups (for rice)", "source": "HEB" }
      ],
      "steps": [
        "Cook brown rice in low-sodium chicken broth per package directions; yields approximately 6 cups cooked (1.5 cups per serving).",
        "Season chicken breasts lightly with garlic powder and salt. Heat a non-stick skillet or grill pan over medium heat.",
        "Add 1 tsp olive oil to pan. Cook chicken breasts 6-7 minutes per side until internal temp reaches 165°F. Rest 5 minutes, then slice.",
        "While chicken cooks, cut corn kernels off cobs. Cook corn in a dry non-stick skillet over medium heat 5-6 minutes until lightly golden, no added fat.",
        "Combine corn, halved cherry tomatoes, lime juice, and Greek yogurt in a bowl. Stir gently. Season lightly with salt.",
        "Plate 1.5 cups brown rice, 7-8 oz sliced chicken breast, and top with corn and cherry tomato salad. Drizzle 1 tsp olive oil over chicken if desired within fat budget.",
        "For toddlers: slice chicken into small bite-size pieces, ensure corn is cut very small or slightly mashed for easy chewing."
      ],
      "kids_tasks": [
        "Tear herb leaves if using fresh parsley (optional garnish)",
        "Help rinse cherry tomatoes in a colander",
        "Place corn cobs into pot with adult supervision"
      ]
    },
    {
