      "name": "Grilled Chicken Breast with Sweet Corn and Zucchini",
      "seasonal_items_used": ["corn", "zucchini"],
      "macros_per_serving": {
        "protein_g": 51,
        "fat_g": 11,
        "carbs_g": 69
      },
      "prep_time": "15 min",
      "cook_time": "25 min",
      "servings": 4,
      "ingredients": [
        "2 lbs boneless skinless chicken breast (7-8 oz per serving)",
        "3 ears fresh corn, kernels cut off (about 2.5 cups)",
        "2 medium zucchini, diced small",
        "1.5 cups dry white rice (makes 6 cups cooked, 1.5 cups per serving)",
        "1 tbsp olive oil (total for entire recipe)",
        "1 tsp garlic powder",
        "1/2 tsp onion powder",
        "1/2 tsp salt",
        "2.5 cups low-sodium chicken broth (for cooking rice)",
        "Fresh parsley for garnish (optional)"
      ],
      "steps": [
        "Cook rice using chicken broth per package instructions. Set aside and keep warm.",
        "Pound chicken breasts to even thickness of about 3/4 inch for uniform cooking.",
        "Season chicken with garlic powder, onion powder, and salt on both sides.",
        "Heat a large non-stick skillet or grill pan over medium heat. Use 1/2 tbsp olive oil.",
        "Cook chicken 6-7 minutes per side until internal temp reaches 165°F. Remove and rest 5 minutes.",
        "In same pan add remaining 1/2 tbsp olive oil over medium heat.",
        "Add zucchini and cook 4 minutes, stirring occasionally until slightly softened.",
        "Add corn kernels and cook another 3-4 minutes until tender. Season lightly with salt.",
        "Slice chicken. Plate 1.5 cups rice, top with corn and zucchini mixture, then sliced chicken.",
        "Garnish with fresh parsley if desired."
      ],
      "kids_tasks": [
        "Help wash the zucchini under the sink",
        "Stir the corn and zucchini in the pan with supervision",
        "Help scoop rice into bowls"
      ]
