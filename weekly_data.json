      "prep_time": "20 min",
      "cook_time": "30 min",
      "servings": 4,
      "ingredients": [
        "1.75 lbs 93% lean ground turkey",
        "4 large zucchini, halved lengthwise",
        "1.5 cups dry white rice (makes 6 cups cooked, 1.5 cups per serving)",
        "1 cup fresh or frozen corn kernels",
        "1/2 cup cherry tomatoes, diced small",
        "1 tbsp olive oil (total for entire recipe)",
        "1/2 tsp garlic powder",
        "1/2 tsp onion powder",
        "1/2 tsp salt",
        "1/4 cup low-sodium chicken broth",
        "2 tbsp shredded mild cheddar cheese (light topping only)"
      ],
      "steps": [
        "Preheat oven to 400°F. Cook rice per package instructions and keep warm.",
        "Halve zucchini lengthwise. Using a spoon scoop out the center flesh leaving 1/4 inch shell. Chop the scooped flesh and reserve.",
