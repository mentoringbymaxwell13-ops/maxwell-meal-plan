      "ingredients": [
        "2 lbs boneless skinless chicken breasts (7-8 oz per adult serving)",
        "2 cups fresh corn kernels (from about 3 ears)",
        "2 ripe peaches, diced",
        "3 cups dry farro (yields approximately 6 cups cooked)",
        "1 tbsp olive oil",
        "Juice of 1 lemon",
        "Zest of 1 lemon",
        "2 cloves garlic, minced",
        "2 tbsp fresh parsley, chopped",
        "Salt to taste"
      ],
      "steps": [
        "Preheat oven to 425°F. Cook farro according to package directions; set aside.",
        "Spread corn kernels on a baking sheet. Roast 10-12 minutes until lightly golden. Set aside.",
        "Pound chicken breasts to even thickness. Season with salt, lemon zest, and garlic.",
        "Heat 1 tbsp olive oil in an oven-safe skillet over medium-high heat. Sear chicken 3 minutes per side.",
        "Transfer skillet to oven. Roast 12-15 minutes until internal temp reaches 165°F. Remove and rest 5 minutes.",
        "Toss cooked farro with roasted corn, diced peaches, lemon juice, and fresh parsley. Season with salt.",
        "Slice chicken and serve over 1.5 cups farro mixture per adult (3/4 cup for toddlers)."
