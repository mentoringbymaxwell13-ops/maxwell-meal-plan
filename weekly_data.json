    {
      "id": 1,
      "name": "Sheet Pan Chicken Breast with Roasted Corn and Zucchini",
      "seasonal_produce_used": ["corn", "zucchini"],
      "macros_per_serving": {
        "protein_g": 51,
        "fat_g": 11,
        "carbs_g": 69
      },
      "prep_time": "15 minutes",
      "cook_time": "30 minutes",
      "ingredients": [
        "2 lbs boneless skinless chicken breasts (7–8 oz per adult serving, proportioned smaller for toddlers)",
        "2 ears fresh corn, kernels cut from cob",
        "2 medium organic zucchini, sliced into half-moons",
        "1 tbsp olive oil (total for entire pan)",
        "1/2 tsp garlic powder",
        "1/2 tsp onion powder",
        "Salt to taste",
        "3 cups dry white rice (yields 6 cups cooked, 1.5 cups per serving)"
      ],
      "steps": [
        "Preheat oven to 400°F. Line a large sheet pan with parchment paper.",
        "Cook white rice according to package directions to yield 6 cups cooked. Set aside.",
        "Pound chicken breasts to even 3/4-inch thickness for uniform cooking.",
        "Place chicken breasts on one side of the sheet pan. Arrange corn kernels and zucchini slices on the other side.",
        "Drizzle all of the 1 tbsp olive oil evenly over the chicken and vegetables.",
        "Season chicken and vegetables lightly with garlic powder, onion powder, and salt.",
        "Roast for 25–30 minutes until chicken reaches internal temperature of 165°F and vegetables are tender.",
        "Let chicken rest 5 minutes, then slice. Serve 7–8 oz sliced chicken over 1.5 cups rice per adult; serve smaller portions for toddlers with soft-cut pieces.",
        "Spoon roasted corn and zucchini alongside rice."
      ],
      "kids_tasks": [
        "Toddlers can help shuck the corn ears before kernels are cut by an adult.",
        "Older toddler can help pour washed zucchini into a bowl."
      ]
    },
    {
      "id": 2,
      "name": "Ground Turkey and Cherry Tomato Rice Bowl",
      "seasonal_produce_used": ["cherry tomatoes"],
      "macros_per_serving": {
        "protein_g": 50,
        "fat_g": 12,
        "carbs_g": 71
      },
      "prep_time": "10 minutes",
      "cook_time": "25 minutes",
      "ingredients": [
        "2 lbs 93/7 lean ground turkey",
        "2 cups organic cherry tomatoes, halved",
        "1 cup low-sodium chicken broth",
        "1 tbsp olive oil (total for skillet)",
        "3 cloves garlic, minced",
        "1/2 medium yellow onion, finely diced",
        "Salt to taste",
        "3 cups dry white rice (yields 6 cups cooked, 1.5 cups per serving)"
      ],
      "steps": [
        "Cook white rice according to package directions. Set aside.",
        "Heat 1 tbsp olive oil in a large skillet over medium heat.",
        "Add diced onion and cook 3–4 minutes until softened and translucent.",
        "Add minced garlic and cook 1 minute.",
        "Add ground turkey, breaking into small crumbles. Cook 8–10 minutes until fully cooked through.",
        "Add halved cherry tomatoes and chicken broth. Stir to combine.",
        "Simmer uncovered 8–10 minutes until tomatoes soften and sauce reduces slightly. Season with salt.",
        "Serve turkey-tomato mixture over 1.5 cups cooked rice per adult. Portion toddler servings with small, easy-to-manage pieces."
      ],
      "kids_tasks": [
        "Toddlers can rinse cherry tomatoes in a colander in the sink with supervision.",
        "Older toddler can help stir the rice in the pot with an adult holding the handle."
      ]
    },
    {
      "id": 3,
      "name": "Lemon Garlic Shrimp with Zucchini and Pasta",
      "seasonal_produce_used": ["zucchini"],
      "macros_per_serving": {
        "protein_g": 51,
        "fat_g": 11,
        "carbs_g": 70
      },
      "prep_time": "12 minutes",
      "cook_time": "20 minutes",
      "ingredients": [
        "2 lbs large raw shrimp, peeled and deveined (31/40 count)",
        "2 medium organic zucchini, diced small",
        "1 tbsp olive oil (total for skillet)",
        "3 cloves garlic, minced",
        "Juice of 1 lemon",
        "Salt to taste",
        "12 oz dry penne pasta (yields approximately 6 cups cooked)",
        "Low-sodium chicken broth as needed to loosen sauce (2–3 tbsp)"
      ],
      "steps": [
        "Bring a large pot of salted water to boil. Cook penne according to package directions to al dente. Reserve 1/4 cup pasta water before draining.",
        "Heat 1 tbsp olive oil in a large skillet over medium heat.",
        "Add diced zucchini and cook 4–5 minutes until tender. Remove and set aside.",
        "Add minced garlic to same skillet and cook 30 seconds.",
        "Add shrimp in a single layer. Cook 1–2 minutes per side until pink and cooked through. Do not overcook.",
        "Return zucchini to skillet. Add lemon juice and 2–3 tbsp reserved pasta water or broth to create a light sauce.",
        "Add drained pasta and toss to combine. Season with salt.",
        "Serve approximately 1.5 cups pasta mixture per adult with shrimp portioned to 7–8 oz. Cut toddler shrimp into small soft pieces."
      ],
      "kids_tasks": [
        "Toddlers can help wash the zucchini under running water.",
        "Older toddler can help squeeze the lemon with a hand juicer with adult supervision."
      ]
    },
    {
      "id": 4,
      "name": "Tilapia Tacos with Corn Salsa and Soft Flour Tortillas",
      "seasonal_produce_used": ["corn", "cherry tomatoes"],
      "macros_per_serving": {
        "protein_g": 50,
        "fat_g": 12,
        "carbs_g": 68
      },
      "prep_time": "15 minutes",
      "cook_time": "20 minutes",
      "ingredients": [
        "2 lbs tilapia fillets",
        "1 tbsp olive oil (total for skillet)",
        "1/2 tsp garlic powder",
        "Salt to taste",
        "2 ears fresh corn, kernels cut from cob",
        "1 cup organic cherry tomatoes, finely diced",
        "Juice of 1 lime",
        "1/4 cup fresh cilantro, chopped (optional for adults)",
        "8 medium soft flour tortillas (approximately 8-inch, about 45g each)",
        "1/2 cup plain non-fat Greek yogurt (as mild topping in place of sour cream)"
      ],
      "steps": [
        "Prepare corn salsa: In a bowl combine corn kernels, diced cherry tomatoes, lime juice, and cilantro if using. Season lightly with salt. Set aside.",
        "Pat tilapia fillets dry. Season both sides with garlic powder and salt.",
        "Heat 1 tbsp olive oil in a large skillet over medium heat.",
        "Cook tilapia 3–4 minutes per side until fish flakes easily with a fork.",
        "Remove fish and flake into large pieces with a fork.",
        "Warm flour tortillas in a dry skillet or wrapped in a damp paper towel in the microwave for 30 seconds.",
        "Assemble tacos: layer flaked tilapia onto tortillas, top with corn salsa and a small dollop of Greek yogurt.",
        "For toddlers, serve flaked fish and corn salsa on a plate alongside a torn soft tortilla for easy eating.",
        "Adults receive 2 tacos each at approximately 3.5–4 oz tilapia per taco to reach 7–8 oz total."
      ],
      "kids_tasks": [
        "Toddlers can help stir the corn salsa in a bowl with a spoon.",
        "Older toddler can help place the tortillas on plates."
      ]
    },
    {
      "id": 5,
      "name": "Baked Cod with Peach Glaze over Brown Rice and Steamed Zucchini",
      "seasonal_produce_used": ["peaches", "zucchini"],
      "macros_per_serving": {
        "protein_g": 51,
        "fat_g": 11,
        "carbs_g": 71
      },
      "prep_time": "15 minutes",
      "cook_time": "30 minutes",
      "ingredients": [
        "2 lbs cod fillets",
        "2 ripe organic peaches, peeled and pureed (approximately 3/4 cup puree)",
        "1 tbsp low-sodium soy sauce",
        "1 tsp honey",
        "1 tsp garlic powder",
        "Salt to taste",
        "2 medium organic zucchini, cut into 1/2-inch rounds",
        "3 cups dry brown rice (yields 6 cups cooked, 1.5 cups per serving)",
        "1 tbsp olive oil (total — brushed lightly on baking dish only)"
      ],
      "steps": [
        "Cook brown rice according to package directions. Note: brown rice takes 40–45 minutes; start first.",
        "Preheat oven to 375°F.",
        "Make peach glaze: blend or mash peeled peaches until smooth. Stir in soy sauce, honey, garlic powder, and a pinch of salt.",
        "Lightly brush a baking dish with the 1 tbsp olive oil using a pastry brush.",
        "Place cod fillets in baking dish. Spoon peach glaze generously over each fillet.",
        "Bake 18–22 minutes until cod flakes easily with a fork and reaches 145°F internal temperature.",
        "While cod bakes, steam zucchini rounds in a steamer basket over boiling water for 5–6 minutes until very tender (toddler-friendly soft texture).",
        "Serve 7–8 oz cod per adult over 1.5 cups cooked brown rice with steamed zucchini alongside. Flake cod into smaller pieces for toddler portions.",
        "Spoon any remaining pan glaze over fish before serving."
      ],
      "kids_tasks": [
        "Toddlers can help wash the peaches and zucchini in the sink.",
        "Older toddler can help spoon the peach puree into the bowl for an adult to mix."
      ]
    }
  ],
