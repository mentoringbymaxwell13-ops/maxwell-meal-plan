      "prep_time": "10 min",
      "cook_time": "25 min",
      "servings": 4,
      "ingredients": [
        "2 lbs cod fillets (7-8 oz per serving)",
        "2 ripe peaches, peeled and very finely diced (sauce will be mild and sweet)",
        "1 cup cherry tomatoes, halved",
        "1.5 cups dry brown rice (makes 6 cups cooked, 1.5 cups per serving)",
        "1 tbsp olive oil (total for entire recipe)",
        "1 tbsp honey",
        "1/4 tsp garlic powder",
        "1/4 tsp salt",
        "1 tbsp lemon juice",
        "2 cups low-sodium chicken broth (for cooking rice)"
      ],
      "steps": [
        "Cook brown rice using chicken broth per package instructions. Keep warm.",
        "Preheat oven to 400°F. Line a baking dish with parchment paper.",
        "In a small saucepan over low heat combine diced peaches, honey, lemon juice, and a pinch of salt. Cook 5 minutes stirring until peaches soften into a gentle glaze. Remove from heat.",
        "Pat cod fillets dry. Brush lightly with olive oil on both sides and season with garlic powder and salt.",
        "Place cod in prepared baking dish.",
        "Spoon peach glaze evenly over each fillet.",
        "Scatter halved cherry tomatoes around the fish in the baking dish.",
        "Bake 15-18 minutes until cod flakes easily with a fork.",
        "Plate 1.5 cups rice, top with cod fillet and spoon pan juices with tomatoes over top.",
        "For toddlers flake cod into small pieces and ensure no bones before serving."
      ],
      "kids_tasks": [
        "Help wash peaches and cherry tomatoes",
        "Help drizzle honey into the saucepan with supervision",
        "Help fluff rice with a fork"
      ]
    },
