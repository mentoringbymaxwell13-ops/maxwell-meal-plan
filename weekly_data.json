      "name": "Tilapia Tacos with Peach Salsa and Cilantro Lime Rice",
      "seasonal_produce_used": ["peaches", "cherry tomatoes", "corn"],
      "macros_per_serving": {
        "protein_g": 50,
        "fat_g": 12,
