      "name": "Ground Turkey Stuffed Zucchini Boats with Corn and Rice",
      "seasonal_items_used": ["zucchini", "corn"],
      "macros_per_serving": {
        "protein_g": 52,
        "fat_g": 11,
        "carbs_g": 68
