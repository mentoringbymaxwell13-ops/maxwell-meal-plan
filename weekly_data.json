      "id": 1,
      "name": "Grilled Chicken Breast with Sweet Corn Succotash and Brown Rice",
      "seasonal_produce_used": ["corn", "cherry tomatoes", "zucchini"],
      "macros_per_serving": {
        "protein_g": 51,
        "fat_g": 11,
        "carbs_g": 69
      },
      "prep_time": "15 minutes",
      "cook_time": "30 minutes",
      "ingredients": [
        "2 lbs boneless skinless chicken breasts (about 7-8 oz per adult serving, 4 oz per toddler)",
        "2 cups fresh corn kernels (from about 3 ears)",
        "1 cup cherry tomatoes, halved",
        "1 medium zucchini, diced small",
        "3 cups dry brown rice (yields 6 cups cooked)",
        "1 tbsp olive oil (total, divided)",
        "1/2 cup low-sodium chicken broth",
        "2 cloves garlic, minced",
        "Salt to taste"
      ],
      "steps": [
        "Cook brown rice according to package directions; set aside and keep warm.",
        "Pound chicken breasts to even thickness. Season lightly with salt.",
        "Heat 1/2 tbsp olive oil in a large nonstick skillet over medium heat. Cook chicken 6-7 minutes per side until internal temp reaches 165°F. Remove and let rest 5 minutes, then slice.",
        "In same skillet, add remaining 1/2 tbsp olive oil over medium heat. Add garlic and sauté 30 seconds.",
        "Add corn and zucchini. Cook 4-5 minutes, stirring occasionally, until just tender.",
        "Add cherry tomatoes and chicken broth. Cook 2 more minutes until tomatoes soften slightly.",
        "Serve sliced chicken over 1.5 cups cooked brown rice per adult (3/4 cup for toddlers) topped with succotash."
      ],
      "kids_tasks": [
        "Toddlers can help rinse cherry tomatoes in a colander with supervision.",
        "Older toddler can help pour pre-measured corn kernels into a bowl."
      ]
    },
    {
      "id": 2,
      "name": "Shrimp and Zucchini Pasta with Cherry Tomato Sauce",
      "seasonal_produce_used": ["zucchini", "cherry tomatoes"],
      "macros_per_serving": {
        "protein_g": 50,
        "fat_g": 12,
        "carbs_g": 68
      },
      "prep_time": "15 minutes",
      "cook_time": "25 minutes",
      "ingredients": [
        "2 lbs large shrimp, peeled and deveined (about 7-8 oz per adult serving)",
        "12 oz whole wheat spaghetti",
        "2 cups cherry tomatoes, halved",
        "1 large zucchini, sliced into half-moons",
        "3 cloves garlic, minced",
        "1 tbsp olive oil",
        "1/2 cup low-sodium chicken broth",
        "1/4 cup freshly grated Parmesan cheese",
        "Salt to taste"
      ],
      "steps": [
        "Cook whole wheat spaghetti according to package directions until al dente. Reserve 1/2 cup pasta water before draining.",
        "Heat 1 tbsp olive oil in a large skillet over medium heat. Add garlic and sauté 30 seconds.",
        "Add zucchini and cook 3-4 minutes until just tender.",
        "Add cherry tomatoes and chicken broth. Simmer 5 minutes until tomatoes break down into a light sauce.",
        "Add shrimp to the skillet. Cook 2-3 minutes per side until pink and cooked through.",
        "Add drained pasta and toss to coat, adding a splash of reserved pasta water if needed to loosen the sauce.",
        "Divide into servings (about 1.5 cups pasta mix per adult, 3/4 cup for toddlers). Top each with 1 tbsp Parmesan."
      ],
      "kids_tasks": [
        "Toddlers can help place cherry tomatoes into a bowl.",
        "Older toddler can help sprinkle Parmesan onto plates."
      ]
