    {
      "id": 3,
      "name": "Ground Turkey and Corn Stuffed Zucchini Boats with Quinoa",
      "seasonal_produce_used": ["zucchini", "corn", "cherry tomatoes"],
      "macros_per_serving": {
        "protein_g": 52,
        "fat_g": 11,
        "carbs_g": 70,
        "notes": "2 boats per adult with quinoa, 1 smaller boat per toddler with proportional quinoa"
      },
      "prep_time": "20 minutes",
      "cook_time": "35 minutes",
      "ingredients": [
        "2 lbs 93% lean ground turkey",
        "4 large zucchini, halved lengthwise (8 halves total)",
        "1 cup fresh corn kernels",
        "1 cup cherry tomatoes, finely diced",
        "3 cups dry quinoa (yields approximately 6 cups cooked)",
        "1 tbsp olive oil",
        "2 cloves garlic, minced",
        "1/2 cup shredded low-moisture part-skim mozzarella",
        "1/2 cup low-sodium chicken broth",
        "Salt to taste"
      ],
      "steps": [
        "Preheat oven to 400°F.",
        "Cook quinoa according to package directions; set aside.",
        "Scoop centers from zucchini halves to create boats; roughly chop the scooped flesh and set aside.",
        "Brush zucchini boats lightly with a very small amount of the olive oil (use no more than 1/2 tsp total for brushing). Place cut-side up on a baking sheet.",
        "Heat remaining olive oil in a skillet over medium heat. Add garlic and sauté 30 seconds. Add ground turkey; cook until no longer pink, about 8 minutes. Drain any excess fat.",
        "Add chopped zucchini flesh, corn, diced cherry tomatoes, and chicken broth. Cook 3-4 minutes until softened. Season with salt.",
        "Fill each zucchini boat with the turkey mixture. Top with shredded mozzarella.",
        "Bake 18-20 minutes until zucchini is tender and cheese is melted.",
        "Serve 2 boats per adult over 1.5 cups cooked quinoa. Serve 1 smaller boat per toddler over 3/4 cup quinoa."
      ],
      "kids_tasks": [
        "Toddlers can help pour corn kernels into the skillet with assistance.",
        "Older toddler can help sprinkle cheese on top of zucchini boats."
      ]
    },
