      "macros": {
        "protein_g": 50,
        "fat_g": 12,
        "carbs_g": 69
      },
      "prep_time": "10 minutes",
      "cook_time": "20 minutes",
      "ingredients": [
        "1.75 lbs large shrimp peeled and deveined (7.5 oz per serving)",
        "12 oz orzo pasta dry (yields about 6 cups cooked)",
        "2 ears fresh corn, kernels cut off",
        "1.5 cups cherry tomatoes, halved",
        "1 tbsp olive oil (total)",
        "1 cup low-sodium chicken broth",
        "2 tbsp lemon juice",
        "2 tbsp grated parmesan cheese (0.5 tbsp per serving)",
        "2 tbsp unsalted butter (total)"
      ],
      "steps": [
        "Cook orzo in salted boiling water according to package directions until tender. Drain and set aside.",
        "Pat shrimp dry with paper towels. Season lightly with garlic powder, onion powder, and salt.",
        "Heat olive oil in a large skillet over medium-high heat. Add shrimp in a single layer.",
        "Cook shrimp 1.5-2 minutes per side until pink and opaque. Remove from skillet and set aside.",
        "Reduce heat to medium. Add butter to the same skillet. Add corn kernels and cook 3-4 minutes.",
        "Add cherry tomatoes and chicken broth. Simmer 3 minutes until tomatoes soften slightly.",
        "Stir in lemon juice and cooked orzo. Mix well and cook 1 minute.",
        "Return shrimp to the skillet and toss gently to combine.",
        "Serve 1.5 cups orzo mixture per bowl topped with shrimp and a sprinkle of parmesan."
